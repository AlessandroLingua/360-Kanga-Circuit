# Copy to `.env.local` (not committed) and fill in your own values.

# Google sign-in + profile sync to the Drive app-data folder (scope drive.appdata).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID → "Web application".
# Authorized JavaScript origins: every origin the web/PWA build is served from,
# e.g. http://localhost:5173 for `npm run dev` and your production https origin.
# Also used as `webClientId` by the native Android/iOS plugin.
VITE_GOOGLE_CLIENT_ID=

# Only for the native iOS app: OAuth client ID of type "iOS" (bundle id com.kangacircuit.app360).
VITE_GOOGLE_IOS_CLIENT_ID=
