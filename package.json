{
  "name": "kanga-circuit-360",
  "productName": "Kanga Circuit 360",
  "version": "0.1.0",
  "private": true,
  "description": "Generative yoga, pilates, HIIT and meditation sessions assembled live on every start.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "tsx scripts/engine-check.ts && tsx scripts/sync-check.ts",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "desktop": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "sync-server": "node server/sync-server.mjs",
    "tts:corpus": "tsx scripts/tts-corpus.ts",
    "tts:samples": "tsx scripts/tts-generate.ts --samples",
    "tts:generate": "tsx scripts/tts-generate.ts"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/ios": "^8.6.3",
    "@capgo/capacitor-health": "^8.13.0",
    "@capgo/capacitor-social-login": "^8.7.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "build": {
    "appId": "com.kangacircuit.app360",
    "productName": "Kanga Circuit 360",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.healthcare-fitness"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
